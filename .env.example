# Copie este arquivo para .env.local e preencha.
# NUNCA commite o .env.local (já está no .gitignore).

# Token do GitHub para listar também os repositórios privados no site.
# Sem ele, o site mostra apenas os repositórios públicos.
# Crie um em: https://github.com/settings/tokens (permissão de leitura de repositórios)
GITHUB_TOKEN=
